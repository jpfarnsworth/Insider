# ---------------------------------------------------------------------------
# Insider Signals — environment configuration
# Copy to `.env.local` and fill in real values. NEVER commit .env.local.
# ---------------------------------------------------------------------------

# --- Database (AWS PostgreSQL, SSL required) --------------------------------
# insider_app: DML only. Used by the web app and workers.
DATABASE_URL=postgresql://insider_app:CHANGE_ME@HOST:5432/insider_signals_dev?sslmode=require
# insider_migrator: DDL. Used ONLY by `npm run db:migrate`.
DATABASE_MIGRATOR_URL=postgresql://insider_migrator:CHANGE_ME@HOST:5432/insider_signals_dev?sslmode=require
# Optional PEM CA bundle for full certificate verification.
DATABASE_SSL_CA=
# Pool size override. Web default 10; set 5 for workers.
DB_POOL_MAX=

# --- Auth.js -----------------------------------------------------------------
# openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3040
# Trust the X-Forwarded-* headers set by nginx.
AUTH_TRUST_HOST=true
# The single email address allowed to sign in.
ALLOWED_EMAIL=
# Resend (magic-link email)
RESEND_API_KEY=
EMAIL_FROM=Insider Signals <signals@example.com>

# --- SEC EDGAR ----------------------------------------------------------------
# Required by SEC fair-access policy: descriptive name + contact email.
# e.g. InsiderSignals you@example.com
SEC_USER_AGENT=

# --- Claude (Milestone 6) ------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# --- Alpaca market data (Milestone 5) ----------------------------------------
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=

# --- Server ---------------------------------------------------------------------
PORT=3040
NODE_ENV=development
