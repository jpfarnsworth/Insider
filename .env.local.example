# ---------------------------------------------------------------------------
# Insider Signals — environment configuration
# Copy to `.env.local` and fill in real values. NEVER commit .env.local.
# ---------------------------------------------------------------------------

# --- Database (AWS PostgreSQL, SSL required) --------------------------------
# insider_app: DML only. Used by the web app and workers.
DATABASE_URL=postgresql://insider_app:CHANGE_ME@HOST:5432/insider_signals_dev?sslmode=require
# insider_migrator: DDL. Used ONLY by `npm run db:migrate`.
DATABASE_MIGRATOR_URL=postgresql://insider_migrator:CHANGE_ME@HOST:5432/insider_signals_dev?sslmode=require
# Optional PEM CA bundle for full certificate verification.
DATABASE_SSL_CA=
# Pool size override. Web default 10; set 5 for workers.
DB_POOL_MAX=

# --- Auth.js -----------------------------------------------------------------
# openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3040
# Trust the X-Forwarded-* headers set by nginx.
AUTH_TRUST_HOST=true
# The single email address allowed to sign in. Set its password with:
#   npm run set-password
ALLOWED_EMAIL=

# --- Notifications (milestone 8, optional) -------------------------------------
# Telegram push for job failures and high-score signals. Make a bot with @BotFather; the chat id is
# the chat that should receive alerts (message the bot, then read it from getUpdates or the Tasks bot's /myid).
# Also turn on the `notifications` switch in Settings.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- MCP server (Phase 2 groundwork) --------------------------------------------
# Bearer token for the read-only MCP endpoint at /api/mcp. Generate with: openssl rand -hex 32
# (at least 32 characters, or the endpoint refuses everything).
MCP_READ_TOKEN=

# --- SEC EDGAR ----------------------------------------------------------------
# Required by SEC fair-access policy: descriptive name + contact email.
# e.g. InsiderSignals you@example.com
SEC_USER_AGENT=

# --- Agent scoring: Gemini 2.5 Flash (Milestone 6) --------------------------------
# Same key the Tasks and Life OS projects use. The model id lives in lib/agent/models.ts.
GEMINI_API_KEY=

# --- Alpaca market data (Milestone 5) ----------------------------------------
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=

# --- Server ---------------------------------------------------------------------
PORT=3040
NODE_ENV=development
